POSTGRES_USER=luno_user
POSTGRES_PASSWORD=luno_password
POSTGRES_DB=luno_db
SECRET_KEY=buraya-uzun-rastgele-bir-anahtar-yazin
ACCESS_TOKEN_EXPIRE_SECONDS=86400
CORS_ORIGINS=http://localhost:5173

# Dosyalar yerel geliştirmede git'e eklenmeyen backend/uploads/ klasörüne yazılır.
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads

# Canlı Supabase Storage kullanırken STORAGE_BACKEND=supabase yapın.
# Project URL ve service_role anahtarını Supabase Dashboard'dan alın.
# Anahtarı bu dosyaya, GitHub'a veya frontend ortam değişkenlerine koymayın.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=luno-files

# LLM servis katmanı: ana servis Groq, yedek Gemini. Anahtarı boş bırakılan servis kullanılmaz.
# Anahtarları GitHub'a veya frontend'e koymayın. Gemini ücretsiz sürümüne gerçek kullanıcı verisi gönderilmez.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=10
LLM_RATE_LIMIT_PER_MINUTE=10
