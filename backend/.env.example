PROJECT_NAME=LUNO
API_V1_STR=/api/v1
# Zorunlu. Boş bırakılırsa uygulama başlamaz. Üretmek için: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=86400
DATABASE_URL=sqlite:///./luno.db
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Dosya depolama: "local" (varsayılan, UPLOAD_DIR klasörü) veya "supabase" (canlı ortam)
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
# STORAGE_BACKEND=supabase ise doldurulur (Supabase > Project Settings > API). Anahtar GitHub'a yüklenmez.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=luno-files
